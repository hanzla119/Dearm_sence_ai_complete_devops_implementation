            "id": 2,
            "title": "YOLOv8 AI Inference Latency (P95 & P50)",
            "type": "timeseries",
            "targets": [
                {
                    "expr": "histogram_quantile(0.95, sum(rate(dermasense_inference_latency_seconds_bucket[1m])) by (le))",
